{
  "audit_dir": ".copilot-audit",
  "edit_tool_words": ["edit", "create", "write", "replace", "patch", "delete", "rename", "move", "insert"],
  "shell_tool_words": ["bash", "powershell", "shell", "terminal", "execute"],
  "protected_paths": [
    ".github/hooks/*",
    "tools/house_style_terms.csv",
    "tools/check_style.py",
    "data/input/*",
    "data/output/baseline/*",
    "assets/*",
    "*.xlsx",
    "*.xlsm",
    "*.xls"
  ],
  "blocked_commands": [
    "git\\s+push",
    "git\\s+reset\\s+--hard",
    "git\\s+clean",
    "rm\\s+-[a-z]*r",
    "Remove-Item\\b.*-Recurse",
    "\\brmdir\\b",
    "\\bdel\\s+/s",
    "\\bcurl\\b",
    "\\bwget\\b",
    "Invoke-WebRequest",
    "Invoke-RestMethod",
    "\\biwr\\b",
    "\\birm\\b"
  ],
  "confirm_commands": [
    "pip\\s+install",
    "conda\\s+install",
    "git\\s+commit",
    "git\\s+checkout\\s+--",
    "git\\s+restore",
    "git\\s+rebase",
    "git\\s+merge"
  ],
  "post_edit_checks": [
    {"name": "ruff lint", "command": "ruff check --fix {path}"},
    {"name": "ruff format", "command": "ruff format {path}"},
    {"name": "house style", "command": "python tools/check_style.py {path}", "when_path_exists": "tools/check_style.py"}
  ],
  "stop_checks": [
    {"name": "unit tests", "command": "python -m pytest -q -x --no-header -p no:cacheprovider", "when_path_exists": "tests", "timeout_sec": 300, "pass_exit_codes": [0, 5]},
    {"name": "model run", "command": "python -m assembly.driver", "when_path_exists": "assembly/driver.py", "timeout_sec": 600},
    {"name": "output reconciliation", "command": "python .github/skills/model-reconciliation/scripts/compare_outputs.py settings/recon.yaml", "when_path_exists": "settings/recon.yaml", "timeout_sec": 300}
  ],
  "max_stop_retries": 2,
  "max_report_chars": 3000
}
