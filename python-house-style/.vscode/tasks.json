{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "house style check",
      "type": "shell",
      "command": "python tools/check_style.py src",
      "group": "test",
      "presentation": { "reveal": "always", "clear": true },
      "problemMatcher": {
        "owner": "house-style",
        "fileLocation": ["relative", "${workspaceFolder}"],
        "pattern": {
          "regexp": "^(.*):(\\d+): (ERROR|WARN) (.*)$",
          "file": 1,
          "line": 2,
          "severity": 3,
          "message": 4
        }
      }
    }
  ]
}
